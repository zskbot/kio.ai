<script>
// Terminal typing demo
const lines = [
  ['$', 'kio "build a landing page"', 'text-slate-500'],
  ['→', 'router: selecting skills & tools...', 'text-sky'],
  ['→', 'skills: frontend, project-analysis', 'text-violet'],
  ['→', 'scanning workspace... done', 'text-mint'],
  ['→', 'plan: 4 steps · executing...', 'text-pink'],
  ['✓', 'build complete · report ready', 'text-slate-300'],
];
const body = document.getElementById('term-body');
let li = 0, ci = 0, cur = null;
function type(){
  if(!cur){
    if(li >= lines.length){ return; }
    cur = document.createElement('p');
    cur.className = lines[li][2];
    body.appendChild(cur); ci = 0;
  }
  const prefix = lines[li][0], text = lines[li][1];
  cur.textContent = prefix + ' ' + text.slice(0, ci++);
  if(ci <= text.length){ setTimeout(type, 28); }
  else { li++; cur = null; setTimeout(type, 260); }
}
setTimeout(type, 600);

// Hero typing
const heroPhrases = [
  '> whoami: builder of autonomous coding agents',
  '> status: pushing KIO.ai · active development',
  '> kotlin: python · agents · open source',
];
let hp = 0, hc = 0, deleting = false;
const typeLine = document.getElementById('typeLine');
function heroType(){
  const phrase = heroPhrases[hp];
  typeLine.textContent = phrase.slice(0, hc);
  if(!deleting && hc < phrase.length){ hc++; setTimeout(heroType, 45); }
  else if(!deleting){ deleting = true; setTimeout(heroType, 1800); }
  else if(hc > 0){ hc--; setTimeout(heroType, 20); }
  else { deleting = false; hp = (hp+1) % heroPhrases.length; setTimeout(heroType, 300); }
}
setTimeout(heroType, 1500);

// Sub-tabs
const tabBtns = document.querySelectorAll('.tab-btn');
tabBtns.forEach(btn => {
  btn.addEventListener('click', () => {
    tabBtns.forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    document.querySelectorAll('.tab-panel').forEach(p => p.classList.add('hidden'));
    document.getElementById('tab-' + btn.dataset.tab).classList.remove('hidden');
  });
});
tabBtns[0].classList.add('active');

// Mobile menu
const menuBtn = document.getElementById('menuBtn');
const mobileMenu = document.getElementById('mobileMenu');
menuBtn.addEventListener('click', () => mobileMenu.classList.toggle('hidden'));
mobileMenu.querySelectorAll('a').forEach(a => a.addEventListener('click', () => mobileMenu.classList.add('hidden')));

// Scroll reveal + active nav + skill bars
const revealEls = document.querySelectorAll('.reveal');
const navLinks = document.querySelectorAll('.nav-link');
const sections = ['about','skills','experience','project','blog','contact'];
const bars = document.querySelectorAll('.bar');
let barsDone = false, revealDone = false;
const io = new IntersectionObserver((entries) => {
  entries.forEach(e => {
    if(e.isIntersecting){
      e.target.classList.add('in');
      if(!barsDone && e.target.id === 'skills'){
        bars.forEach(b => { b.style.width = b.dataset.w; });
        barsDone = true;
      }
    }
  });
}, { threshold: .12 });
revealEls.forEach(el => io.observe(el));

const spy = new IntersectionObserver((entries) => {
  entries.forEach(e => {
    if(e.isIntersecting){
      navLinks.forEach(l => l.classList.remove('active'));
      const link = document.querySelector('.nav-link[href="#'+e.target.id+'"]');
      if(link) link.classList.add('active');
    }
  });
}, { rootMargin: '-40% 0px -55% 0px' });
sections.forEach(id => { const el = document.getElementById(id); if(el) spy.observe(el); });
</script>
